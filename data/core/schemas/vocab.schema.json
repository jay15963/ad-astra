          "kind"
        ],
        "properties": {
          "era": {
            "$ref": "common.schema.json#/$defs/eraId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "status": {
            "enum": [
              "reserved"
            ]
