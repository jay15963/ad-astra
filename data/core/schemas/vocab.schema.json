  "properties": {
    "_doc": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "frozen": {
      "$ref": "common.schema.json#/$defs/ym"
    },
    "naming": {
      "type": "object"
    },
    "destinations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "body",
          "kind",
          "era",
          "label"
        ],
        "properties": {
          "era": {
            "$ref": "common.schema.json#/$defs/eraId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "status": {
            "enum": [
              "reserved"
            ]
          },
          "needs": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "body": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "destinationFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern",
          "from",
          "kind",
          "era"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "pattern": {
            "type": "string",
            "pattern": "^[a-z0-9_]*[{](star|planet|region)[}][a-z0-9_]*$"
          },
          "from": {
            "enum": [
              "stars",
              "exoplanets",
              "regions"
            ]
          },
          "body": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "era": {
            "$ref": "common.schema.json#/$defs/eraId"
          }
        }
      }
    },
    "bodies": {
      "type": "object",
      "additionalProperties": {
