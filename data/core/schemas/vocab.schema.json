{
  "$id": "vocab.schema.json",
  "description": "Vocabulário congelado da Fase C (core/vocab.json, EXPANSION.md §14 C0). Chaves de cada mapa = ids (^[a-z0-9_]+$).",
  "type": "object",
  "required": [
    "version",
    "destinations",
    "destinationFamilies",
    "bodies",
    "milestones",
    "destinationKinds",
    "missionTypes",
    "spacecraftKinds",
    "vehicleClasses",
    "eventKinds",
    "eventGroups",
    "eventTags",
    "techBranches",
    "partKinds",
    "partFamilies",
    "rocketTemplates",
    "holderKinds",
    "investorProfiles",
