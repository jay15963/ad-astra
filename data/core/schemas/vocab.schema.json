              "era": {
                "$ref": "common.schema.json#/$defs/eraId"
              },
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z]+:[a-z0-9_.]+$"
              }
            }
          }
        ]
      }
    },
    "unlockKeys": {
      "type": "object",
      "description": "MISSIONS-V2 §0/§4.5: chave <tipo>:<id> → {era, label}",
      "propertyNames": {
        "pattern": "^(_doc|[a-zA-Z]+:[a-z0-9_.]+)$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "era",
              "label"
            ],
            "properties": {
              "era": {
                "$ref": "common.schema.json#/$defs/eraId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "techEffects": {
      "type": "object",
      "description": "MISSIONS-V2 §4.6: chaves de efeito dos nós de tecnologia e sua unidade",
      "additionalProperties": {
        "type": "object",
        "required": [
          "unit"
        ],
        "properties": {
          "unit": {
            "enum": [
              "pp",
              "pct",
              "pctAbs",
              "pctNeg",
              "int",
              "num"
            ]
          },
          "era": {
            "$ref": "common.schema.json#/$defs/eraId"
          }
        }
      }
    }
  }
}
