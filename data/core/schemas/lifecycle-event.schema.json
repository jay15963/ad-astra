{
  "$id": "lifecycle-event.schema.json",
  "description": "Evento do ciclo de vida (core/lifecycle.json → events[]; §3.2). Meses base 0.",
  "type": "object",
  "required": [
    "id",
    "date",
    "op"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "date": {
      "$ref": "common.schema.json#/$defs/ym"
    },
    "op": {
      "enum": [
        "birth",
        "rename",
        "merge",
        "split",
        "dissolve",
        "nationSplit",
        "privatize",
        "nationalize"
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "from": {
      "$ref": "common.schema.json#/$defs/idList"
    },
    "into": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "$ref": "common.schema.json#/$defs/idList"
        }
      ]
    },
    "nation": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "to": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "common.schema.json#/$defs/id"
        }
      ]
    },
    "truthLayer": {
      "$ref": "common.schema.json#/$defs/truthLayer"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    }
  }
}
