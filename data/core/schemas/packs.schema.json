{
  "$id": "packs.schema.json",
  "description": "Manifesto (data/packs.json; §4.1).",
  "type": "object",
  "required": [
    "version",
    "packs",
    "scenarios"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "dir",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "era": {
            "$ref": "common.schema.json#/$defs/eraId"
          },
          "always": {
            "type": "boolean"
          },
          "legacy": {
            "type": "boolean"
          },
          "years": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "dir": {
            "type": "string",
            "pattern": "^(|[a-z0-9_/-]+/)$"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "\\.json$"
      }
    }
  }
}
