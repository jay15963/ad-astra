{
  "$id": "era-meta.schema.json",
  "description": "Metadados de era (eras/eN/era.json).",
  "type": "object",
  "required": [
    "id",
    "name",
    "from",
    "to",
    "chapters"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/eraId"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "from": {
      "type": "integer"
    },
    "to": {
      "type": "integer"
    },
    "truthLayers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/truthLayer"
      },
      "minItems": 1
    },
    "closingMilestone": {
      "type": "string"
    },
    "palette": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "from",
          "title"
        ],
        "properties": {
          "from": {
            "$ref": "common.schema.json#/$defs/ym"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          }
        }
      }
    }
  }
}
